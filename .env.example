# Required for the Ask Nare widget and `npm run eval:ask`
ANTHROPIC_API_KEY=

# Optional: override the chat model (default: claude-haiku-4-5-20251001)
# ASK_MODEL=claude-haiku-4-5-20251001
# Optional: separate judge model for evals (defaults to ASK_MODEL)
# ASK_JUDGE_MODEL=

# Optional embeddings for retrieval. If neither is set, BM25 keyword search is used.
# Set one, then run `npm run build:index` (also runs automatically before `next build`).
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
# EMBEDDING_MODEL=

# Public site URL (used for metadata, sitemap, RSS, OpenGraph)
SITE_URL=http://localhost:3000
